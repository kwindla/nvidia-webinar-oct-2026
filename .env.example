OPENAI_API_KEY=
NVIDIA_ASR_URL=http://127.0.0.1:8081
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=gb-phone
# ATC tutor fine-tune on Modal (optional third model): .../v1 and the gb-serving-key value.
TUNED_LLM_URL=
TUNED_LLM_API_KEY=
# Prompt the tuned model was trained with: v2 (v2/v3 models) or v13 (v1.3 models).
TUNED_PROMPT=v2
# Model each new session starts on: cloud, local or tuned (unavailable choices fall back to cloud).
DEFAULT_LLM=cloud
BASE_ASR_URL=http://127.0.0.1:8082
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=flux-heather-en

# Cloudflare TURN: long-lived secrets stay on the server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
