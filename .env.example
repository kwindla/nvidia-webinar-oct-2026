OPENAI_API_KEY=
NVIDIA_ASR_URL=http://127.0.0.1:8081
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=gb-phone
# LOCAL_LLM_NAME=Local Mini
# Tuned: local vLLM (e.g. http://127.0.0.1:8083/v1) or authenticated remote .../v1.
# Loopback needs no credential: blank uses an SDK dummy key. Remote requires its serving key.
TUNED_LLM_URL=
TUNED_LLM_API_KEY=
# TUNED_LLM_NAME=ATC tutor · local
# Prompt the tuned model was trained with: v2 (v2/v3 models) or v13 (v1.3 models).
TUNED_PROMPT=v2
# Default when no explicit pick: cloud, local or tuned; unavailable defaults fall back to cloud.
# An unavailable explicit pick follows this default chain, with a visible client notice.
DEFAULT_LLM=cloud
BASE_ASR_URL=http://127.0.0.1:8082
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=flux-heather-en

# Cloudflare TURN: long-lived secrets stay on the server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
